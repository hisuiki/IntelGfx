#!/bin/sh
# SPDX-License-Identifier: MIT
# Select the experimental binary under the SAME legacy-driver name so only
# one driver owns the Intel PCI function. Loaded drivers change after reboot.
set -eu

# The home directory, not the system one: the kernel ranks a driver by the
# directory its path starts with and tests the system directory before the
# system's non-packaged directory, which that path also starts with. A driver
# under the system's non-packaged directory therefore ties with the packaged
# driver of the same name and loses to it, while one under the home directory
# is ranked on its own and is scanned first.
base=$(finddir B_USER_NONPACKAGED_ADDONS_DIRECTORY)/kernel/drivers
binary=$base/bin/intel_extreme
device=$base/dev/graphics/intel_extreme
target=/boot/system/data/intel_gfx/kernel/intel_gfx
renderer_base=$(finddir B_USER_NONPACKAGED_ADDONS_DIRECTORY)/opengl
renderer=$renderer_base/Intel\ Gallium
renderer_target=/boot/system/data/intel_gfx/opengl/Intel\ Gallium
vulkan_icd_base=$(finddir B_USER_NONPACKAGED_DATA_DIRECTORY)/vulkan/icd.d
vulkan_icd=$vulkan_icd_base/intel_icd.x86_64.json
vulkan_icd_target=/boot/system/data/intel_gfx/vulkan/intel_icd.x86_64.json
vulkan_lib_base=$(finddir B_USER_NONPACKAGED_LIB_DIRECTORY)
vulkan_lib=$vulkan_lib_base/libvulkan_intel.so
vulkan_lib_target=/boot/system/data/intel_gfx/vulkan/libvulkan_intel.so

owned_link()
{
	[ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]
}

case "${1:-status}" in
	status)
		if owned_link "$binary" "$target"; then
			echo "IntelGfx selected for next boot."
		else
			echo "IntelGfx is not selected by this tool."
		fi
		if owned_link "$renderer" "$renderer_target"; then
			echo "Intel Iris OpenGL is selected for new applications."
		else
			echo "Intel Iris OpenGL is not selected by this tool."
		fi
		if owned_link "$vulkan_icd" "$vulkan_icd_target"; then
			echo "Intel Vulkan (ANV) is selected for Vulkan applications."
		else
			echo "Intel Vulkan (ANV) is not selected by this tool."
		fi
		echo "Use intel_gfx_ctl list to inspect the currently loaded driver."
		;;
	enable)
		[ -f "$target" ] || { echo "Install the IntelGfx HPKG first." >&2; exit 1; }
		[ -f "$renderer_target" ] || { echo "The Intel Iris renderer is missing from the HPKG." >&2; exit 1; }
		for path in "$binary" "$device"; do
			if [ -e "$path" ] || [ -L "$path" ]; then
				if [ "$path" = "$binary" ]; then expected=$target; else expected=../../bin/intel_extreme; fi
				owned_link "$path" "$expected" || {
					echo "Refusing to replace existing override: $path" >&2; exit 1;
				}
			fi
		done
		if [ -e "$renderer" ] || [ -L "$renderer" ]; then
			owned_link "$renderer" "$renderer_target" || {
				echo "Refusing to replace existing OpenGL add-on: $renderer" >&2; exit 1;
			}
		fi
		mkdir -p "$base/bin" "$base/dev/graphics"
		mkdir -p "$renderer_base"
		owned_link "$binary" "$target" || ln -s "$target" "$binary"
		owned_link "$device" ../../bin/intel_extreme || ln -s ../../bin/intel_extreme "$device"
		owned_link "$renderer" "$renderer_target" || ln -s "$renderer_target" "$renderer"
		if [ -f "$vulkan_icd_target" ]; then
			mkdir -p "$vulkan_icd_base" "$vulkan_lib_base"
			owned_link "$vulkan_icd" "$vulkan_icd_target" || ln -s "$vulkan_icd_target" "$vulkan_icd"
			if [ -f "$vulkan_lib_target" ]; then
				owned_link "$vulkan_lib" "$vulkan_lib_target" || ln -s "$vulkan_lib_target" "$vulkan_lib"
			fi
		fi
		echo "IntelGfx, Intel Iris OpenGL, and Vulkan ANV selected. Reboot to load the kernel driver."
		;;
	disable)
		if owned_link "$vulkan_icd" "$vulkan_icd_target"; then rm "$vulkan_icd"; fi
		if owned_link "$vulkan_lib" "$vulkan_lib_target"; then rm "$vulkan_lib"; fi
		if owned_link "$renderer" "$renderer_target"; then rm "$renderer"; fi
		if owned_link "$device" ../../bin/intel_extreme && owned_link "$binary" "$target"; then
			rm "$device"
		fi
		if owned_link "$binary" "$target"; then rm "$binary"; fi
		echo "IntelGfx, Intel Iris, and Vulkan overrides removed. Reboot to restore the packaged driver."
		;;
	*)
		echo "Usage: intel_gfx_activate [status|enable|disable]" >&2
		exit 2
		;;
esac
