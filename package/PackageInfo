packager "IntelGfx contributors"
vendor "IntelGfx contributors"
copyrights {
	"2006-2026 Haiku, Inc. and contributors"
	"2026 IntelGfx contributors"
}
licenses { "IntelGfx" }
provides {
	intel_gfx = 0.2.0
	mesa_iris = 22.0.5
	cmd:intel_gfx_ctl = 0.2.0
	cmd:intel_gfx_activate = 0.2.0
}
requires {
	haiku
	mesa == 22.0.5 base
}
